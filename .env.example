# =============================================================================
# .env.example — Template de configuration du projet
# =============================================================================
# Usage :
#   cp .env.example .env
#   Renseigner toutes les valeurs marquées "← À renseigner"
#   Ne jamais committer .env — il est dans .gitignore
#
# Consommateurs :
#   - Scripts Python ingestion  → variables GCP_ et INGESTION_*
#   - Docker Compose            → toutes les variables
#   - Terraform local (infra-iac) → TF_VAR_*
#   - dbt local                 → DBT_* et GCP_*
# =============================================================================


# =============================================================================
# 1. GCP — Projet et authentification
# =============================================================================

# Identifiant du projet GCP cible
GCP_PROJECT_ID=your-gcp-project-id                        # ← À renseigner
# Alias requis par certaines librairies Google Cloud SDK
GOOGLE_CLOUD_PROJECT=your-gcp-project-id                  # ← même valeur que GCP_PROJECT_ID

GCP_REGION=us-central1
GCP_LOCATION=US

# Chemin vers les credentials GCP dans le conteneur Docker
# Mode recommandé (ADC) : /root/.config/gcloud/application_default_credentials.json
# Mode clé SA JSON      : /workspace/secrets/gcp-sa.json
GOOGLE_APPLICATION_CREDENTIALS=/root/.config/gcloud/application_default_credentials.json


# =============================================================================
# 2. Ingestion — Credentials API
# =============================================================================
# En production (Cloud Run Job), ces valeurs sont lues depuis GCP Secret Manager.
# En local, les définir directement ici.

# France Travail — OAuth2 (obligatoire pour source france_travail)
FT_CLIENT_ID=                                             # ← À renseigner
FT_CLIENT_SECRET=                                         # ← À renseigner

# Jooble — clé API (obligatoire pour source jooble)
JOOBLE_API_KEY=                                           # ← À renseigner

# data.gouv.fr — optionnel (seulement si rate limiting nécessite une auth)
DATAGOUV_API_KEY=

# API Géo, APEC, Sirène : pas de credentials requis


# =============================================================================
# 3. Ingestion — Noms des secrets Secret Manager
# =============================================================================
# Ces noms doivent correspondre exactement aux IDs créés par Terraform (section 11).
# À modifier uniquement si vous renommez les secrets dans Secret Manager.

FT_CLIENT_ID_SECRET_NAME=FT_CLIENT_ID
FT_CLIENT_SECRET_SECRET_NAME=FT_CLIENT_SECRET
JOOBLE_API_KEY_SECRET_NAME=JOOBLE_API_KEY
DATAGOUV_API_KEY_SECRET_NAME=DATAGOUV_API_KEY


# =============================================================================
# 4. Ingestion — Runtime
# =============================================================================

# Source à exécuter : france_travail | apec | jooble | sirene | geo | all
INGESTION_SOURCE=france_travail

# Bucket GCS de destination — obligatoire
# Calculé par Terraform : datatalent-<env>-<project_id>-raw
INGESTION_RAW_BUCKET=                                     # ← À renseigner

# Préfixes GCS par source — doivent correspondre aux TF_VAR_ingestion_*_prefix (section 9)
INGESTION_FRANCE_TRAVAIL_PREFIX=raw/france_travail/
INGESTION_APEC_PREFIX=raw/apec/
INGESTION_JOOBLE_PREFIX=raw/jooble/
INGESTION_SIRENE_PREFIX=raw/sirene/
INGESTION_GEO_PREFIX=raw/geo/

# APEC — paramètres optionnels (valeurs par défaut du code)
APEC_BASE_URL=https://www.apec.fr
# true = enrichissement via pages détail (description complète) ; false = listing seul (rapide)
APEC_FETCH_DETAIL=true


# =============================================================================
# 5. Ingestion — Endpoints APIs sources
# =============================================================================
# Modifiables pour pointer vers un environnement de test ou staging.

FRANCE_TRAVAIL_API_BASE_URL=https://api.francetravail.io/partenaire/offresdemploi/v2
GEO_API_BASE_URL=https://geo.api.gouv.fr
SIRENE_SOURCE_BASE_URL=https://www.data.gouv.fr/fr/datasets/base-sirene-des-entreprises-et-de-leurs-etablissements-siren-siret/


# =============================================================================
# 6. dbt
# =============================================================================
# Variables lues par dbt/transformation/profiles.yml et le service Docker Compose "dbt".

# Cible de profil : dev (OAuth ADC, local) | ci (OAuth ADC, CI/Cloud Run)
DBT_TARGET=dev
DBT_THREADS=4

# Dataset BigQuery où dbt écrit les modèles
DBT_BIGQUERY_DATASET=staging

# Paramètres d'exécution BigQuery
DBT_BIGQUERY_PRIORITY=interactive
DBT_BIGQUERY_TIMEOUT_SECONDS=300
DBT_BIGQUERY_JOB_RETRIES=1

# Optionnel — surcharger GCP_PROJECT_ID / GCP_LOCATION pour dbt uniquement
# DBT_BIGQUERY_PROJECT=your-gcp-project-id
# DBT_BIGQUERY_LOCATION=EU


# =============================================================================
# 7. Terraform — Projet GCP
# =============================================================================
# TF_VAR_project_id / region / location reprennent GCP_PROJECT_ID / GCP_REGION / GCP_LOCATION.
# Terraform lit les TF_VAR_* — les deux groupes sont nécessaires car consommateurs différents.

TF_VAR_project_id=your-gcp-project-id                    # ← même valeur que GCP_PROJECT_ID
TF_VAR_region=us-central1
TF_VAR_location=US
TF_VAR_environment=dev
TF_VAR_project_prefix=datatalent

# Nom du bucket raw explicite — optionnel, calculé automatiquement si vide
# Format par défaut : datatalent-<env>-<project_id>-raw (max 63 caractères)
# TF_VAR_raw_bucket_name=datatalent-dev-my-raw-bucket


# =============================================================================
# 8. Terraform — Bucket raw (lifecycle)
# =============================================================================

TF_VAR_bucket_versioning_enabled=true
TF_VAR_bucket_force_destroy=false

# Transition NEARLINE désactivée — NEARLINE facture min 30j, conflit avec delete à 30j
# TF_VAR_bucket_nearline_age_days=null  ← laisser commenté, la variable utilise le défaut (null)

# Suppression globale — filet de sécurité
TF_VAR_bucket_lifecycle_delete_age_days=365

# Purge par source après 30/31 jours
# Sources hebdomadaires → ~4 partitions conservées
# Sources mensuelles    → 1 snapshot mensuel
TF_VAR_bucket_france_travail_prefix_delete_age_days=30
TF_VAR_bucket_apec_prefix_delete_age_days=30
TF_VAR_bucket_jooble_prefix_delete_age_days=30
TF_VAR_bucket_sirene_prefix_delete_age_days=31
TF_VAR_bucket_geo_prefix_delete_age_days=31


# =============================================================================
# 9. Terraform — Préfixes GCS
# =============================================================================
# Doivent correspondre aux INGESTION_*_PREFIX (section 4).
# Ces valeurs sont aussi injectées comme env vars dans le Cloud Run Job ingestion.

TF_VAR_ingestion_france_travail_prefix=raw/france_travail/
TF_VAR_ingestion_apec_prefix=raw/apec/
TF_VAR_ingestion_jooble_prefix=raw/jooble/
TF_VAR_ingestion_sirene_prefix=raw/sirene/
TF_VAR_ingestion_geo_prefix=raw/geo/


# =============================================================================
# 10. Terraform — BigQuery
# =============================================================================

TF_VAR_raw_dataset_id=raw
TF_VAR_staging_dataset_id=staging
TF_VAR_intermediate_dataset_id=intermediate
TF_VAR_marts_dataset_id=marts

# true  = Terraform gère les bindings projet roles/bigquery.jobUser (recommandé en local)
# false = bindings appliqués manuellement (voir docs/infra/iam_roles.md section 3/4)
TF_VAR_manage_project_job_user_bindings=true


# =============================================================================
# 11. Terraform — Secret Manager
# =============================================================================
# Noms des secrets créés par Terraform — doivent correspondre aux *_SECRET_NAME (section 3).

TF_VAR_secret_ft_client_id_name=FT_CLIENT_ID
TF_VAR_secret_ft_client_secret_name=FT_CLIENT_SECRET
TF_VAR_secret_jooble_api_key_name=JOOBLE_API_KEY
TF_VAR_secret_datagouv_api_key_name=DATAGOUV_API_KEY


# =============================================================================
# 12. Terraform — Comptes de service
# =============================================================================
# À renseigner une fois les SA créés (voir docs/platform/gcp_terminal_setup.md).
# Format : <nom-sa>@<project_id>.iam.gserviceaccount.com

TF_VAR_ingestion_service_account_email=                   # ← À renseigner
TF_VAR_dbt_service_account_email=                         # ← À renseigner
TF_VAR_dashboard_service_account_email=                   # ← À renseigner

# SA WIF de la CI — même email que GCP_WIF_SERVICE_ACCOUNT dans GitHub Secrets
TF_VAR_ci_service_account_email=                          # ← À renseigner

# SA utilisé par Cloud Scheduler pour déclencher le Cloud Run Job
# Si vide, Terraform utilise TF_VAR_ingestion_service_account_email comme fallback
TF_VAR_scheduler_service_account_email=


# =============================================================================
# 13. Terraform — Cloud Run Job ingestion
# =============================================================================
# Passer create_compute_job=true après le premier push de l'image dans Artifact Registry.
# Passer create_external_tables=true après la première ingestion réussie
# (BQ autodetect requiert au moins un fichier Parquet dans le bucket).

TF_VAR_create_compute_job=false
TF_VAR_create_external_tables=false

TF_VAR_compute_job_name=datatalent-ingestion-job
TF_VAR_compute_image=us-central1-docker.pkg.dev/your-gcp-project-id/datatalent/ingestion:latest
TF_VAR_compute_memory=512Mi
TF_VAR_compute_cpu=1
TF_VAR_compute_timeout_seconds=1800
TF_VAR_compute_max_retries=1


# =============================================================================
# 14. Terraform — Cloud Run Job dbt
# =============================================================================
# Passer create_dbt_job=true après le premier push de l'image dbt dans Artifact Registry.

TF_VAR_create_dbt_job=false

TF_VAR_dbt_job_name=datatalent-dbt-job
TF_VAR_dbt_compute_image=us-central1-docker.pkg.dev/your-gcp-project-id/datatalent/dbt:latest
TF_VAR_dbt_memory=1Gi
TF_VAR_dbt_cpu=1
TF_VAR_dbt_timeout_seconds=1800
TF_VAR_dbt_max_retries=0


# =============================================================================
# 15. Terraform — Cloud Scheduler
# =============================================================================
# 2 schedulers ingestion passent INGESTION_SOURCE= en override, 1 scheduler dbt sans override.
# weekly  → INGESTION_SOURCE=weekly  → datatalent-ingestion-job (france_travail + apec + jooble)
# monthly → INGESTION_SOURCE=monthly → datatalent-ingestion-job (sirene + geo)
# dbt     → body vide               → datatalent-dbt-job (pas de INGESTION_SOURCE)
# Tous en timezone Europe/Paris.

TF_VAR_scheduler_job_name_prefix=datatalent-ingestion
TF_VAR_scheduler_time_zone=Europe/Paris

# 3 schedulers (dans le free tier GCP)
TF_VAR_scheduler_ingestion_weekly_schedule=0 6 * * 1
TF_VAR_scheduler_ingestion_monthly_schedule=0 3 1 * *
TF_VAR_scheduler_dbt_schedule=0 9 * * 1


# =============================================================================
# 16. Terraform — Artifact Registry
# =============================================================================
# keep_recent_versions=1 : conserve uniquement latest par image.
# older_than_seconds=1   : purge quasi-immédiate des versions excédentaires (asynchrone GCP).

TF_VAR_artifact_registry_keep_recent_versions=1
TF_VAR_artifact_registry_cleanup_dry_run=false
TF_VAR_artifact_registry_cleanup_delete_older_than_seconds=1


# =============================================================================
# 17. Terraform — Cloud Logging
# =============================================================================
# Gère la rétention du bucket _Default Cloud Logging.
# Nécessite roles/logging.configWriter sur le SA Terraform.
# Mettre à false si ce rôle n'est pas accordé sur votre projet (voir docs/infra/iam_roles.md).

TF_VAR_manage_log_retention=true
TF_VAR_log_retention_days=60
